# Generated by `tkt herdr install`; rerun it after moving the tkt binary.
id = "tkt"
name = "tkt"
version = {{VERSION}}
min_herdr_version = "0.9.5"
description = "Sprint tickets with their pull requests and CI, from Jira and GitHub"
platforms = ["linux", "macos"]

[[startup]]
command = [{{TKT}}, "herdr", "restore"]

[[actions]]
id = "board"
title = "tkt: board"
command = [{{TKT}}, "herdr", "open-board"]

[[actions]]
id = "ticket"
title = "tkt: ticket pane"
contexts = ["workspace"]
command = [{{TKT}}, "herdr", "open-ticket"]

[[actions]]
id = "refresh"
title = "tkt: refresh sidebar"
command = [{{TKT}}, "herdr", "refresh"]

[[actions]]
id = "setup"
title = "tkt: set up"
command = [{{TKT}}, "herdr", "setup"]

[[actions]]
id = "open"
title = "tkt: open ticket from link"
command = [{{TKT}}, "herdr", "open"]

[[events]]
on = "worktree.created"
command = [{{TKT}}, "herdr", "on-worktree"]

[[panes]]
id = "board"
title = "tkt board"
placement = "popup"
width = "95%"
height = "95%"
command = [{{TKT}}, "board"]

[[panes]]
id = "ticket"
title = "Ticket"
placement = "split"
command = [{{TKT}}, "show", "--watch"]

[[panes]]
id = "ticket-popup"
title = "Ticket"
placement = "popup"
width = "80%"
height = "80%"
command = [{{TKT}}, "herdr", "ticket-popup"]

# A tab rather than a popup: setup takes several steps and Herdr popups cannot be moved or closed by hand.
[[panes]]
id = "setup"
title = "tkt setup"
placement = "tab"
command = [{{TKT}}, "init"]

[[link_handlers]]
id = "jira"
title = "Open the Jira ticket in tkt"
pattern = '^https://[^/]+\.atlassian\.net/browse/[A-Z][A-Z0-9]+-[0-9]+'
action = "open"

[[link_handlers]]
id = "pr"
title = "Open the pull request's ticket in tkt"
pattern = '^https://github\.com/[^/]+/[^/]+/pull/[0-9]+'
action = "open"
